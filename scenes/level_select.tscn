[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/level_select.gd" id="1_level_select"]

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_level_select")

[node name="Panel" type="MarginContainer" parent="."]
layout_mode = 0
offset_left = 90.0
offset_top = 100.0
offset_right = 870.0
offset_bottom = 980.0

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 44
text = "ВЫБОР УРОВНЯ"
horizontal_alignment = 1

[node name="Info" type="Label" parent="Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Доступны достигнутые контрольные уровни"
horizontal_alignment = 1

[node name="LevelGrid" type="GridContainer" parent="Panel/Content"]
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 18
columns = 5

[node name="BackButton" type="Button" parent="Panel/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 70)
theme_override_font_sizes/font_size = 26
text = "НАЗАД"

[connection signal="pressed" from="Panel/Content/BackButton" to="." method="_on_back_pressed"]
